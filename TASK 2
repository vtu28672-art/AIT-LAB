      "cell_type": "code",
      "source": [
        "grid = [\n",
        "    ['00', '01', '02'],\n",
        "    ['10', '11', '12'],\n",
        "    ['20', '21', '22']\n",
        "]\n",
        "\n",
        "visited = [[False] * 3 for _ in range(3)]\n",
        "\n",
        "# Right, Down, Left, Up\n",
        "directions = [\n",
        "    (0, 1),\n",
        "    (1, 0),\n",
        "    (0, -1),\n",
        "    (-1, 0)\n",
        "]\n",
        "\n",
        "def find_paths(row, col, path):\n",
        "\n",
        "    # Destination is 12\n",
        "    if row == 1 and col == 2:\n",
        "        print(\" -> \".join(path))\n",
        "        return\n",
        "\n",
        "    visited[row][col] = True\n",
        "\n",
        "    for dr, dc in directions:\n",
        "\n",
        "        new_row = row + dr\n",
        "        new_col = col + dc\n",
        "\n",
        "        if (0 <= new_row < 3 and\n",
        "            0 <= new_col < 3 and\n",
        "            not visited[new_row][new_col]):\n",
        "\n",
        "            find_paths(\n",
        "                new_row,\n",
        "                new_col,\n",
        "                path + [grid[new_row][new_col]]\n",
        "            )\n",
        "\n",
        "    # Backtracking\n",
        "    visited[row][col] = False\n",
        "\n",
        "\n",
        "# Start from 00\n",
        "find_paths(0, 0, ['00'])"
      ],
